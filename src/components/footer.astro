---
import SocialLinks from './SocialLinks.astro'

const currentYear = new Date().getFullYear()
---

<footer class="bg-pastel-dark mt-12 pt-8 pb-6 text-gray-700 lg:mt-10 lg:py-4">
  <div class="container mx-auto max-w-7xl px-4">
    <div class="order-1 flex flex-col-reverse items-center justify-between gap-3 md:flex-row">
      <div class="md:mb-0">
        <p class="text-sm">&copy; {currentYear} Furekunst. Alle rettar reserverte.</p>
      </div>

      <div class="order-2 md:order-3">
        <SocialLinks variant="footer" />
      </div>
    </div>
  </div>
</footer>
