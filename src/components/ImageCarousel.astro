---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

export interface CarouselItem {
  src: ImageMetadata
  alt: string
}

interface Props {
  images: CarouselItem[]
}

const { images } = Astro.props
---

<div class="relative" data-carousel>
  <div class="overflow-hidden">
    <div
      class="-ml-4 flex snap-x snap-mandatory overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      data-carousel-track
    >
      {images.map((image, index) => (
        <div
          class="min-w-0 shrink-0 grow-0 basis-full snap-start pl-4"
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} av ${images.length}`}
        >
          <div class="overflow-hidden rounded-sm">
            <Image
              src={image.src}
              alt={image.alt}
              width={828}
              widths={[640, 750, 828]}
              sizes="calc(100vw - 4.5rem)"
              quality={55}
              loading="lazy"
              data-fade-img
              class="h-auto w-full object-cover blur-[1px] transition-all duration-500 ease-out"
            />
          </div>
        </div>
      ))}
    </div>
  </div>

  <button
    type="button"
    data-carousel-prev
    aria-label="Forrige bilete"
    class="absolute top-1/2 left-2 flex size-8 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-white/80 text-gray-800 shadow transition-colors duration-300 hover:bg-white"
  >
    <svg
      class="size-4"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m15 18-6-6 6-6" />
    </svg>
    <span class="sr-only">Forrige bilete</span>
  </button>
  <button
    type="button"
    data-carousel-next
    aria-label="Neste bilete"
    class="absolute top-1/2 right-2 flex size-8 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-white/80 text-gray-800 shadow transition-colors duration-300 hover:bg-white"
  >
    <svg
      class="size-4"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m9 18 6-6-6-6" />
    </svg>
    <span class="sr-only">Neste bilete</span>
  </button>

  <div class="mt-4 flex justify-center gap-2" data-carousel-dots>
    {images.map((_image, index) => (
      <button
        type="button"
        data-carousel-dot={index}
        aria-label={`Gå til bilete ${index + 1}`}
        aria-current={index === 0 ? 'true' : undefined}
        class={`h-2 w-2 cursor-pointer rounded-full transition-all ${
          index === 0 ? 'w-4 bg-primary' : 'bg-primary/50'
        }`}
      ></button>
    ))}
  </div>
</div>

<script>
  let root: HTMLElement | null = null
  let track: HTMLElement | null = null
  let prevBtn: HTMLButtonElement | null = null
  let nextBtn: HTMLButtonElement | null = null
  let dots: HTMLButtonElement[] = []
  let slides: HTMLElement[] = []
  let initialized = false
  let desktop: MediaQueryList | null = null
  let clickHandlers: Array<{ el: HTMLElement; handler: () => void }> = []

  let current = 0
  let autoplayTimer = 0
  let autoplayActive = false
  let scrollRaf = 0
  let wasPlayingOnHide = false

  const stopAutoplay = () => {
    autoplayActive = false
    window.clearInterval(autoplayTimer)
  }
  const startAutoplay = () => {
    if (autoplayActive || slides.length < 2) return
    autoplayActive = true
    autoplayTimer = window.setInterval(() => goTo(current + 1), 4000)
  }

  const updateDots = (index: number) => {
    dots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.add('w-4', 'bg-primary')
        dot.classList.remove('w-2', 'bg-primary/50')
        dot.setAttribute('aria-current', 'true')
      } else {
        dot.classList.remove('w-4', 'bg-primary')
        dot.classList.add('w-2', 'bg-primary/50')
        dot.removeAttribute('aria-current')
      }
    })
  }

  const goTo = (index: number) => {
    if (!track || slides.length === 0) return
    const target = (index + slides.length) % slides.length
    current = target
    const slide = slides[target]
    if (slide) {
      track.scrollTo({
        left: slide.offsetLeft - track.offsetLeft,
        behavior: 'smooth',
      })
    }
    updateDots(target)
  }

  const onScroll = () => {
    if (!track || slides.length === 0) return
    window.cancelAnimationFrame(scrollRaf)
    scrollRaf = window.requestAnimationFrame(() => {
      if (!track) return
      const scrollLeft = track.scrollLeft
      let closestIndex = 0
      let closestDistance = Infinity
      slides.forEach((slide, i) => {
        const dist = Math.abs(slide.offsetLeft - track!.offsetLeft - scrollLeft)
        if (dist < closestDistance) {
          closestDistance = dist
          closestIndex = i
        }
      })
      if (closestIndex !== current) {
        current = closestIndex
        updateDots(current)
      }
    })
  }

  const onKeyDown = (e: KeyboardEvent) => {
    if (e.key === 'ArrowLeft') {
      stopAutoplay()
      goTo(current - 1)
    } else if (e.key === 'ArrowRight') {
      stopAutoplay()
      goTo(current + 1)
    }
  }

  const onVisibilityChange = () => {
    if (document.hidden) {
      wasPlayingOnHide = autoplayActive
      stopAutoplay()
    } else if (wasPlayingOnHide) {
      startAutoplay()
    }
  }

  const addClick = (el: HTMLElement | null, handler: () => void) => {
    if (!el) return
    el.addEventListener('click', handler)
    clickHandlers.push({ el, handler })
  }

  const init = () => {
    root = document.querySelector<HTMLElement>('[data-carousel]')
    if (!root) return
    track = root.querySelector<HTMLElement>('[data-carousel-track]')
    prevBtn = root.querySelector<HTMLButtonElement>('[data-carousel-prev]')
    nextBtn = root.querySelector<HTMLButtonElement>('[data-carousel-next]')
    dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'))
    slides = Array.from(root.querySelectorAll<HTMLElement>('[data-carousel-track] > [role="group"]'))
    if (!track || slides.length === 0) return

    current = 0
    updateDots(0)

    addClick(prevBtn, () => {
      stopAutoplay()
      goTo(current - 1)
    })
    addClick(nextBtn, () => {
      stopAutoplay()
      goTo(current + 1)
    })
    dots.forEach((dot, i) => {
      addClick(dot, () => {
        stopAutoplay()
        goTo(i)
      })
    })

    track.addEventListener('scroll', onScroll, { passive: true })
    root.addEventListener('keydown', onKeyDown)
    root.addEventListener('mouseenter', stopAutoplay)
    root.addEventListener('mouseleave', startAutoplay)
    root.addEventListener('focusin', stopAutoplay)
    root.addEventListener('focusout', startAutoplay)
    root.addEventListener('touchstart', stopAutoplay, { passive: true })
    document.addEventListener('visibilitychange', onVisibilityChange)

    startAutoplay()
  }

  const teardown = () => {
    stopAutoplay()
    window.cancelAnimationFrame(scrollRaf)
    for (const { el, handler } of clickHandlers) {
      el.removeEventListener('click', handler)
    }
    clickHandlers = []
    if (track) track.removeEventListener('scroll', onScroll)
    if (root) {
      root.removeEventListener('keydown', onKeyDown)
      root.removeEventListener('mouseenter', stopAutoplay)
      root.removeEventListener('mouseleave', startAutoplay)
      root.removeEventListener('focusin', stopAutoplay)
      root.removeEventListener('focusout', startAutoplay)
      root.removeEventListener('touchstart', stopAutoplay)
    }
    document.removeEventListener('visibilitychange', onVisibilityChange)
  }

  const initCarousel = () => {
    desktop = window.matchMedia('(min-width: 768px)')
    const update = () => {
      if (desktop?.matches) {
        if (initialized) {
          teardown()
          initialized = false
        }
      } else {
        if (!initialized) {
          init()
          initialized = true
        }
      }
    }
    desktop.addEventListener('change', update)
    update()
  }

  initCarousel()
</script>
