---
// Mobile-only image carousel — vanilla port of islands/ImageCarousel.tsx
// (FK-014). CSS scroll-snap + one bundled script (embla-core is not
// installed; only the React variants). Preserves the embla behavior exactly:
// autoplay every 4s that stops permanently on interaction/hover/focus,
// prev/next arrows, dot indicators, keyboard arrows, aria slide roles.
// Desktop keeps the grid instead (wrapper is `md:hidden` in index.astro).
interface CarouselImage {
  src: string
  srcSet?: string
  sizes?: string
  alt: string
  width: number
  height: number
}

interface Props {
  images: CarouselImage[]
}

const { images } = Astro.props
---

<div class="relative" data-carousel>
  <div class="overflow-hidden">
    <div class="no-scrollbar -ml-4 flex snap-x snap-mandatory overflow-x-auto" data-carousel-track>
      {images.map((image, index) => (
        <div
          class="min-w-0 shrink-0 grow-0 basis-full snap-start pl-4"
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} av ${images.length}`}
        >
          <div class="overflow-hidden rounded-sm">
            <img
              src={image.src}
              srcset={image.srcSet}
              sizes={image.sizes}
              alt={image.alt}
              width={image.width}
              height={image.height}
              loading="lazy"
              data-fade-img
              class="h-auto w-full object-cover blur-[1px] transition-all duration-500 ease-out"
            />
          </div>
        </div>
      ))}
    </div>
  </div>

  <button
    type="button"
    data-carousel-prev
    aria-label="Forrige bilete"
    class="absolute top-1/2 left-2 flex size-8 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-white/80 text-gray-800 shadow transition-colors duration-300 hover:bg-white"
  >
    <svg
      class="size-4"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m15 18-6-6 6-6" />
    </svg>
    <span class="sr-only">Forrige bilete</span>
  </button>
  <button
    type="button"
    data-carousel-next
    aria-label="Neste bilete"
    class="absolute top-1/2 right-2 flex size-8 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-white/80 text-gray-800 shadow transition-colors duration-300 hover:bg-white"
  >
    <svg
      class="size-4"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m9 18 6-6-6-6" />
    </svg>
    <span class="sr-only">Neste bilete</span>
  </button>

  <div class="mt-4 flex justify-center gap-2" data-carousel-dots>
    {images.map((image, index) => (
      <button
        type="button"
        data-carousel-dot={index}
        aria-label={`Gå til bilete ${index + 1}`}
        aria-current={index === 0 ? 'true' : undefined}
        class={`h-2 w-2 cursor-pointer rounded-full transition-all ${
          index === 0 ? 'w-4 bg-primary' : 'bg-primary/50'
        }`}
      ></button>
    ))}
  </div>
</div>

<style>
  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Full-page navigation (no ClientRouter — see global.css) runs this module
  // fresh on every page load, so the carousel hooks itself up directly at
  // module scope below (initCarousel()); no `astro:page-load` re-init needed.
  let root: HTMLElement | null = null
  let track: HTMLElement | null = null
  let prevBtn: HTMLButtonElement | null = null
  let nextBtn: HTMLButtonElement | null = null
  let dots: HTMLButtonElement[] = []
  let slides: HTMLElement[] = []
  let initialized = false
  let desktop: MediaQueryList | null = null
  // Named click handlers registered in init() and removed in teardown():
  // init()/teardown() run again on every matchMedia crossing below/above
  // 768px, and anonymous handlers can never be removed (duplicate-listener
  // bug — one click advancing several slides).
  let clickHandlers: Array<{ el: HTMLElement; handler: () => void }> = []

  let current = 0
  let autoplayTimer = 0
  let autoplayActive = false
  let scrollRaf = 0
  let wasPlayingOnHide = false

  const stopAutoplay = () => {
    autoplayActive = false
    window.clearInterval(autoplayTimer)
  }
  const startAutoplay = () => {
    if (autoplayActive || slides.length < 2) return
    autoplayActive = true
    autoplayTimer = window.setInterval(() => goTo(current + 1), 4000)
  }

  const positions = () => {
    const trackLeft = track?.offsetLeft ?? 0
    return slides.map(slide => slide.offsetLeft - trackLeft)
  }

  const updateDots = () => {
    dots.forEach((dot, index) => {
      const active = index === current
      dot.classList.toggle('w-4', active)
      dot.classList.toggle('bg-primary', active)
      dot.classList.toggle('bg-primary/50', !active)
      if (active) dot.setAttribute('aria-current', 'true')
      else dot.removeAttribute('aria-current')
    })
  }

  const goTo = (index: number) => {
    if (!track || slides.length === 0) return
    current = ((index % slides.length) + slides.length) % slides.length
    track.scrollTo({ left: positions()[current], behavior: 'smooth' })
    updateDots()
  }

  const onScroll = () => {
    if (scrollRaf || !track) return
    // The `!track` guard does not narrow inside the rAF callback (`track` is
    // module-scope mutable), so capture the non-null ref in a const here.
    const trackEl = track
    scrollRaf = requestAnimationFrame(() => {
      scrollRaf = 0
      const pos = positions()
      let nearest = current
      for (let i = 0; i < pos.length; i++) {
        if (Math.abs(trackEl.scrollLeft - pos[i]) < Math.abs(trackEl.scrollLeft - pos[nearest])) {
          nearest = i
        }
      }
      if (nearest !== current) {
        current = nearest
        updateDots()
      }
    })
  }

  const onKeyDown = (event: KeyboardEvent) => {
    if (event.key === 'ArrowLeft') goTo(current - 1)
    else if (event.key === 'ArrowRight') goTo(current + 1)
  }

  const onVisibility = () => {
    if (document.hidden) {
      wasPlayingOnHide = autoplayActive
      stopAutoplay()
    } else if (wasPlayingOnHide) {
      wasPlayingOnHide = false
      startAutoplay()
    }
  }

  const init = () => {
    if (!root || !track || !prevBtn || !nextBtn) return
    current = 0
    updateDots()
    startAutoplay()
    track.addEventListener('scroll', onScroll)
    root.addEventListener('pointerdown', stopAutoplay)
    root.addEventListener('mouseenter', stopAutoplay)
    root.addEventListener('focusin', stopAutoplay)
    const onPrev = () => {
      stopAutoplay()
      goTo(current - 1)
    }
    prevBtn.addEventListener('click', onPrev)
    clickHandlers.push({ el: prevBtn, handler: onPrev })
    const onNext = () => {
      stopAutoplay()
      goTo(current + 1)
    }
    nextBtn.addEventListener('click', onNext)
    clickHandlers.push({ el: nextBtn, handler: onNext })
    dots.forEach(dot => {
      const handler = () => {
        stopAutoplay()
        goTo(Number(dot.dataset.carouselDot))
      }
      dot.addEventListener('click', handler)
      clickHandlers.push({ el: dot, handler })
    })
  }

  const teardown = () => {
    stopAutoplay()
    track?.removeEventListener('scroll', onScroll)
    root?.removeEventListener('pointerdown', stopAutoplay)
    root?.removeEventListener('mouseenter', stopAutoplay)
    root?.removeEventListener('focusin', stopAutoplay)
    for (const { el, handler } of clickHandlers) {
      el.removeEventListener('click', handler)
    }
    clickHandlers.length = 0
  }

  const initCarousel = () => {
    root = document.querySelector<HTMLElement>('[data-carousel]')
    if (!root) return
    track = root.querySelector<HTMLElement>('[data-carousel-track]')
    prevBtn = root.querySelector<HTMLButtonElement>('[data-carousel-prev]')
    nextBtn = root.querySelector<HTMLButtonElement>('[data-carousel-next]')
    dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'))
    slides = track ? Array.from(track.children) as HTMLElement[] : []

    // The component is hidden with `md:hidden` on desktop, where the grid
    // replaces it — only initialize (and autoplay) when actually visible.
    if (!desktop) {
      desktop = window.matchMedia('(min-width: 768px)')
      desktop.addEventListener('change', () => {
        if (desktop!.matches && initialized) {
          teardown()
          initialized = false
        } else if (!desktop!.matches && !initialized) {
          init()
          initialized = true
        }
      })
    }
    if (!desktop.matches) {
      init()
      initialized = true
    }
  }

  // Plain full-page navigation (no ClientRouter — see global.css) means this
  // script runs fresh on every page load; init directly.
  initCarousel()

  // Global listeners registered once at module scope.
  document.addEventListener('keydown', onKeyDown)
  document.addEventListener('visibilitychange', onVisibility)
  window.addEventListener('resize', onScroll)
</script>
