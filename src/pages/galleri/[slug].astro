---
import type { GetImageResult, LiveDataEntry } from 'astro'
import { getLiveCollection } from 'astro:content'
import { getImage } from 'astro:assets'
import MainLayout from '../../layouts/MainLayout.astro'
import ArtworkDetails from '../../components/ArtworkDetails.astro'
import ArtworkZoom from '../../components/ArtworkZoom.astro'
import Button from '../../components/Button.astro'
import { priceHint } from '../../lib/price'
import type { GalleryPostData } from '../../lib/gallery'

// FK-018: artwork detail is on-demand — no getStaticPaths, looked up from the
// live collection. NOTE: this dynamic route is shadowed by the static
// original.astro / print.astro routes for any artwork whose slug is literally
// "original" or "print" (static routes win in Astro's route precedence).
const { entries, error, cacheHint } = await getLiveCollection('galleryPosts')

if (Astro.cache.enabled) {
  if (cacheHint) Astro.cache.set(cacheHint)
  Astro.cache.set({ maxAge: 3600 })
}

if (error) {
  console.error(`Failed to load gallery posts: ${error.message}`)
  Astro.response.status = 500
}

const post = (entries ?? []).find(entry => entry.data.slug === Astro.params.slug)
if (!post && !error) {
  Astro.response.status = 404
}

interface DetailRender {
  post: LiveDataEntry<GalleryPostData>
  image: GetImageResult
  zoomImage: GetImageResult
  metaDescription: string
  ogImage: string
  structuredData: Record<string, unknown>
}

let detail: DetailRender | null = null
const imageAsset = post?.data.image

if (post && imageAsset) {
  const { data } = post

  // The page image must use the EXACT same optimized URL as the gallery card
  // (width 700, quality 55): the gallery → detail morph captures the new
  // page's snapshot at first render, and only a URL the browser already has
  // in cache (from the card the user just clicked) decodes in time. A
  // different URL would show a blank frame and the image would pop back in.
  // The zoom dialog gets its own hi-res variant (see zoomImage).
  const imageWidth = Math.min(imageAsset.width, 700)
  const imageHeight = Math.max(
    1,
    Math.round((imageAsset.height / imageAsset.width) * imageWidth),
  )
  const image = await getImage({
    src: imageAsset.url,
    width: imageWidth,
    height: imageHeight,
    quality: 55,
  })
  // Hi-res variant for the fullscreen zoom dialog (displayed much larger).
  const zoomImage = await getImage({
    src: imageAsset.url,
    width: Math.min(imageAsset.width, 1500),
    height: Math.max(
      1,
      Math.round((imageAsset.height / imageAsset.width) * Math.min(imageAsset.width, 1500)),
    ),
    quality: 85,
  })

  const typeLabel = data.type === 'original' ? 'Original' : 'Print'
  const sizeInfo = data.type === 'original' && data.size ? `Storleik: ${data.size}.` : ''
  const priceInfo = priceHint(data) ?? ''
  const metaDescription = data.description
    ? [data.description, sizeInfo, priceInfo].filter(Boolean).join(' ')
    : `${data.title} - ${typeLabel} av Elisabeth Fure Schwarz. ${[sizeInfo, priceInfo].filter(Boolean).join(' ')}`.trim()

  const printOffers = data.sizeAndPrice
    .filter(item => item.price > 0)
    .map(item => ({
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      priceCurrency: 'NOK',
      price: item.price,
      description: `Storleik: ${item.size}`,
    }))

  const offers =
    data.type === 'print'
      ? printOffers.length > 0
        ? printOffers
        : null
      : {
          '@type': 'Offer',
          availability: 'https://schema.org/InStock',
          priceCurrency: 'NOK',
          price: (data.price ?? 0) > 0 ? data.price : 'Ikke oppgitt',
        }

  const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'VisualArtwork',
    name: data.title,
    description: data.description || 'Kunstverk av Elisabeth Fure Schwarz',
    artMedium: data.description.trim().split(/\s+/)[0] || 'Måleri',
    artform: typeLabel,
    image: imageAsset.url,
    url: new URL(Astro.url.pathname, Astro.site ?? 'https://furekunst.no').toString(),
    ...(data.size ? { size: data.size } : {}),
    creator: {
      '@type': 'Person',
      name: 'Elisabeth Fure Schwarz',
      url: 'https://furekunst.no',
    },
    ...(offers ? { offers } : {}),
  }

  detail = {
    post,
    image,
    zoomImage,
    metaDescription,
    ogImage: `${imageAsset.url}?w=1200&h=630&fit=fill`,
    structuredData,
  }
}
---

{detail ? (
  <MainLayout
    title={`${detail.post.data.title} | Furekunst`}
    description={detail.metaDescription}
    ogImage={detail.ogImage}
    canonical={`/galleri/${detail.post.data.slug}`}
  >
    <Fragment slot="head">
      <link rel="preload" as="image" href={detail.image.src} fetchpriority="high" />
      <script is:inline type="application/ld+json" set:html={JSON.stringify(detail.structuredData)}></script>
    </Fragment>

    <div class="mx-auto px-4 md:px-0">
      <a
        href="/galleri"
        data-astro-prefetch
        class="mb-3 inline-flex items-center gap-2 text-sm font-medium text-gray-800 transition-colors duration-300 hover:text-primary"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Galleri
      </a>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="overflow-visible p-1">
          <ArtworkZoom
            src={detail.image.src}
            zoomSrc={detail.zoomImage.src}
            alt={detail.post.data.title}
            width={detail.image.attributes.width}
            height={detail.image.attributes.height}
            passpartout={detail.post.data.passepartout}
            transitionName={`art-${detail.post.data.slug}`}
          />
        </div>

        <ArtworkDetails post={detail.post} />
      </div>
    </div>
  </MainLayout>
) : (
  <MainLayout
    title={error ? 'Noko gjekk gale | Furekunst' : 'Sida ikkje funnen | Furekunst'}
    description={
      error
        ? 'Kunne ikkje laste kunstverket. Prøv igjen om ei stund.'
        : 'Sida du leita etter finst ikkje.'
    }
    noindex
  >
    <div class="flex min-h-[50vh] flex-col items-center justify-center text-center">
      <h1 class="mb-4 text-3xl font-bold">
        {error ? 'Noko gjekk gale' : 'Ikkje funnen'}
      </h1>
      <p class="mb-8 max-w-md text-gray-600">
        {error
          ? 'Kunne ikkje laste kunstverket akkurat no. Prøv igjen om ei stund.'
          : 'Kunstverket du leita etter finst ikkje.'}
      </p>
      <Button type="link" href="/galleri" prefetch class="px-4 py-1 text-sm">
        Sjå galleriet
      </Button>
    </div>
  </MainLayout>
)}
