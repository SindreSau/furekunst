---
import { Image, getImage } from 'astro:assets'
import { getEntry } from 'astro:content'
import MainLayout from '../layouts/MainLayout.astro'
import Separator from '../components/Separator.astro'
import Button from '../components/Button.astro'
import FadeInSection from '../components/FadeInSection.astro'
import ImageCarousel from '../components/ImageCarousel.astro'
import { getBlurDataUrl } from '../lib/blur'
import { parseMarkdownParagraphs } from '../lib/markdown'
import { getSeoSettings } from '../lib/seo'

import defaultLazyDogs from '../assets/img/lazy-dogs.jpg'
import defaultLazyDogsBlur from '../assets/img/lazy-dogs-blur.webp'
import defaultProfilbilde from '../assets/img/profilbilde.jpeg'
import defaultHjort from '../assets/img/hjort.jpeg'
import defaultSjimpanse from '../assets/img/sjimpanse.jpeg'
import defaultLabrador from '../assets/img/labrador.jpeg'

const homeEntry = await getEntry('home', 'index')
const seoSettings = await getSeoSettings()
const homeData = homeEntry?.data

const heroDesktopImage = homeData?.heroDesktopImage ?? defaultLazyDogs
const heroDesktopAlt = homeData?.heroDesktopAlt ?? 'Bilde: Lazy dogs'
const heroMobileImage = homeData?.heroMobileImage

const aboutHeading = homeData?.aboutHeading ?? 'Om Kunstnaren'
const aboutImage = homeData?.aboutImage ?? defaultProfilbilde
const aboutImageAlt = homeData?.aboutImageAlt ?? 'Portrett av Elisabeth Fure Schwarz'

const defaultAboutText = `Hei og hå! Mitt namn er Elisabeth Fure Schwarz, og det er eg som står bak enkeltpersonforetaket Fure.kunst.

Frå 2019-2021 gjekk eg på Einar Granum Kunstfagskule, der eg andre året hadde fordjupning i maleri og billedkunst. Sidan då har eg solgt både originalar og print av det eg har laga, mest gjennom marknadsføring på instagramkontoen min Fure.kunst.

Mitt favorittmedium å male med er akvarell, men det går også mykje i akryl og litt i olje. Elles finn du fleire tegningar laga med tusj og penn.

Ta gjerne kontakt om du skulle vere interessert i noko av det du finn her på nettsida, eller om du har ønske om å bestille eit personleg bilete.`

const rawAboutText =
  homeData?.aboutText ||
  (homeData?.aboutParagraphs?.length
    ? homeData.aboutParagraphs.join('\n\n')
    : defaultAboutText)
const aboutParagraphsHtml = parseMarkdownParagraphs(rawAboutText)

const featuredHeading = homeData?.featuredHeading ?? 'Nokre utvalgte bilete'
const featuredItems = homeData?.featuredItems?.length
  ? homeData.featuredItems.map(item => ({ src: item.image, alt: item.alt }))
  : [
      { src: defaultHjort, alt: 'Bilde: Hjort' },
      { src: defaultSjimpanse, alt: 'Bilde: Sjimpanse' },
      { src: defaultLabrador, alt: 'Bilde: Labrador' },
    ]

const galleryBtnText = homeData?.galleryButtonText ?? 'Galleri'
const contactBtnText = homeData?.contactButtonText ?? 'Ta kontakt'
const pageTitle = seoSettings.homeSeoTitle
const pageDescription = seoSettings.homeSeoDescription

// Mobile hero image (if configured)
const mobileHeroOptimized = heroMobileImage
  ? await getImage({
      src: heroMobileImage,
      width: 640,
      quality: 55,
    })
  : null

// Desktop hero placeholder
const blurDataUrl = await getBlurDataUrl(heroDesktopImage)
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
>
  <FadeInSection initiallyVisible>
    <div class="relative mb-8 aspect-[3/4] w-full overflow-hidden bg-pastel-dark md:mb-12 md:aspect-[1754/1241]">
      {blurDataUrl ? (
        <img
          src={blurDataUrl}
          alt=""
          aria-hidden="true"
          class="absolute inset-0 hidden h-full w-full object-cover blur-[1px] md:block"
        />
      ) : (
        <Image
          src={defaultLazyDogsBlur}
          alt=""
          aria-hidden="true"
          width={1754}
          height={1241}
          loading="eager"
          fetchpriority="low"
          decoding="async"
          class="absolute inset-0 hidden h-full w-full object-cover blur-[1px] md:block"
        />
      )}
      <picture class="absolute inset-0 h-full w-full">
        {mobileHeroOptimized && (
          <source
            media="(max-width: 767px)"
            srcset={mobileHeroOptimized.srcSet?.attribute || mobileHeroOptimized.src}
            width={mobileHeroOptimized.attributes.width}
            height={mobileHeroOptimized.attributes.height}
          />
        )}
        <Image
          src={heroDesktopImage}
          sizes="(min-width: 1280px) 1216px, calc(100vw - 4rem)"
          alt={heroDesktopAlt}
          width={1920}
          widths={[640, 750, 828, 1080, 1200, 1920]}
          quality={70}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          data-fade-img
          class="absolute inset-0 h-full w-full object-cover blur-[1px] transition-all duration-500 ease-out"
        />
      </picture>
    </div>
  </FadeInSection>

  <FadeInSection delay={50}>
    <Separator />
  </FadeInSection>

  <section
    class="my-12 flex flex-col-reverse items-center gap-5 md:flex-row md:items-start md:gap-0"
  >
    <FadeInSection delay={100} className="md:w-1/3">
      <div class="overflow-hidden">
        <Image
          src={aboutImage}
          alt={aboutImageAlt}
          width={828}
          widths={[640, 750, 828]}
          sizes="(min-width: 768px) calc(33.333vw - 1.4rem), 50vw"
          quality={65}
          loading="lazy"
          data-fade-img
          class="frame-shadow h-full w-full max-w-[50vw] rounded-sm object-cover blur-[1px] transition-all duration-500 ease-out sm:rounded-none md:max-w-none"
        />
      </div>
    </FadeInSection>

    <FadeInSection delay={70}>
      <div class="mx-4 my-auto hidden h-auto w-px self-stretch bg-gray-300 md:block"></div>
    </FadeInSection>

    <div class="flex flex-col md:w-2/3">
      <FadeInSection delay={70}>
        <h1 class="font-didot mb-6">{aboutHeading}</h1>
      </FadeInSection>

      <FadeInSection delay={125}>
        <div class="flex flex-col gap-4 tracking-wider text-gray-700">
          {aboutParagraphsHtml.map(paragraphHtml => (
            <p set:html={paragraphHtml} />
          ))}
        </div>
      </FadeInSection>
    </div>
  </section>

  <FadeInSection delay={50}>
    <Separator />
  </FadeInSection>

  <section class="py-12">
    <FadeInSection delay={70}>
      <h2 class="font-didot mb-8 text-center">{featuredHeading}</h2>
    </FadeInSection>

    <FadeInSection delay={125} className="md:hidden">
      <div class="px-1 md:px-0">
        <ImageCarousel images={featuredItems} />
      </div>
    </FadeInSection>

    <div class="hidden gap-8 md:grid md:grid-cols-3">
      {featuredItems.map((item, index) => (
        <FadeInSection delay={125 + index * 70}>
          <div class="aspect-auto h-full overflow-hidden">
            <Image
              src={item.src}
              alt={item.alt}
              width={750}
              widths={[640, 750, 828]}
              sizes="(max-width: 1279px) calc(33.333vw - 2.75rem), 384px"
              quality={55}
              loading="lazy"
              data-fade-img
              class="frame-shadow h-full w-full object-cover blur-[1px] transition-all duration-500 ease-out"
            />
          </div>
        </FadeInSection>
      ))}
    </div>

    <FadeInSection delay={40}>
      <div class="mt-12 flex justify-center gap-12">
        <Button type="link" href="/galleri">
          {galleryBtnText}
        </Button>
        <Button type="link" href="/kontakt">
          {contactBtnText}
        </Button>
      </div>
    </FadeInSection>
  </section>
</MainLayout>

