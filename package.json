{
  "name": "furekunst",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "vdev": "vercel dev --listen 0.0.0.0:3000",
    "vpreview": "pnpm build && vercel dev --listen 0.0.0.0:3000",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "start": "astro preview",
    "check": "astro check",
    "lint": "astro check",
    "format": "prettier --write .",
    "perf:collect": "lhci collect --config=./lighthouserc.cjs",
    "perf:assert": "lhci assert --config=./lighthouserc.cjs",
    "perf:run": "pnpm perf:collect && pnpm perf:assert",
    "perf:baseline": "lhci collect --config=./lighthouserc.cjs --settings.emulatedFormFactor=mobile && lhci assert --config=./lighthouserc.cjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.3",
    "@astrojs/vercel": "11.0.4",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.7",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
